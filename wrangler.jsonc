{
  "name": "nekobato-net",
  "main": "worker/index.ts",
  "compatibility_date": "2025-12-15",
  "observability": {
    "issues": {
      "enabled": true,
    },
  },
  // Void's prerendered pages served through the existing Workers Assets binding.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
}
